{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["tablet", "phone", "2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // The VPN extension must be able to hold sockets while backgrounded.
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      // Restricted (ACL) permission required by third-party VPN apps.
      // Must also be declared in the ACL section of the AppGallery / local
      // signing profile (see ohos/README.md -> Signing).
      { "name": "ohos.permission.ACCESS_EXTENSIONAL_DEVICE_DRIVER" },
      // Continuous task (long-running background) for the VPN extension.
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING" }
      // NOTE: ohos.permission.NOTIFICATION_CONTROLLER removed — it is a
      // system_basic permission unavailable to third-party apps; publishing
      // the app's own notification does not require it.
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:module_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "exported": true,
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        // Continuous task (long-running background) declaration for the VPN
        // service: startBackgroundRunning(["dataTransfer"]) cross-checks the
        // app's backgroundModes. NOTE: on the API 12 SDK "backgroundModes" is
        // only a valid tag under "abilities" — the schema rejects it under
        // extensionAbilities (supported there from API 15+, which this tool
        // chain does not ship). The official Huawei VPN sample declares it
        // exactly here, on the UIAbility.
        "backgroundModes": ["dataTransfer"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "ClashVpnExtensionAbility",
        "srcEntry": "./ets/vpn/ClashVpnExtensionAbility.ets",
        "description": "$string:vpn_desc",
        "type": "vpn",
        "exported": false
      }
    ]
  }
}
